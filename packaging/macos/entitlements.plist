<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for direct Developer ID distribution.
  The app is not sandboxed (it must write to arbitrary user-chosen gallery
  folders and read user-exported cookie files), and it needs the network and
  file access that a normal non-sandboxed app already has — so no entitlement
  broadens privileges beyond that. Kept minimal on purpose: every extra
  entitlement weakens Gatekeeper/notarization scrutiny and is unnecessary here.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
